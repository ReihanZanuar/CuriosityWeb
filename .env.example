# ==========================================
# CURIOSITY AI — DOCKER ENVIRONMENT CONFIG
# ==========================================

# Port web server di host
PORT=8080

# URL backend Ollama yang ingin diakses oleh Nginx reverse proxy
# Pilihan:
# 1. Jika Ollama ada di host mesin yang sama dengan Docker:
#    http://host.docker.internal:11434
# 2. Jika Ollama di server lain / IP Tailscale / LAN:
#    http://100.104.58.74:11434
#    http://192.168.1.100:11434
OLLAMA_BACKEND_URL=http://host.docker.internal:11434
